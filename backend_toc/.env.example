# Copia in .env.local e compila i valori (non committare .env.local).

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Push TOC → cellulare (Firebase Admin). Progetto: allarme-app-2026-b9f74
# Console → Impostazioni → Account di servizio → Genera nuova chiave privata (.json)

# Windows (consigliato): percorso assoluto al file scaricato
FIREBASE_SERVICE_ACCOUNT_PATH=C:\Users\TUO\Downloads\allarme-app-2026-b9f74-firebase-adminsdk-xxxxx.json

# Alternativa (Vercel o una riga): intero JSON del service account
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"allarme-app-2026-b9f74",...}
